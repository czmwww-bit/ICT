{
  "name": "silver-service-evidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "format": "prettier --write src examples test scripts *.json",
    "verify": "node scripts/verify.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:restore": "node scripts/setup-restore.mjs",
    "check:service": "node scripts/check-service.mjs",
    "test": "tsx --test test/*.test.ts",
    "test:db": "tsx --test test/mysql.integration.ts",
    "db:init": "tsx src/cli.ts init",
    "db:migrate": "tsx src/cli.ts migrate",
    "data:validate": "tsx src/cli.ts validate",
    "data:import": "tsx src/cli.ts import",
    "data:query": "tsx src/cli.ts query",
    "data:history": "tsx src/cli.ts history",
    "data:publish": "tsx src/cli.ts publish",
    "data:show": "tsx src/maintenance.ts show",
    "data:status": "tsx src/maintenance.ts status",
    "data:update:check": "tsx src/maintenance.ts check",
    "data:updates": "tsx src/maintenance.ts updates",
    "data:backup": "tsx src/backup-cli.ts backup",
    "data:restore": "tsx src/backup-cli.ts restore",
    "demo:query": "tsx examples/query-real.ts",
    "demo:medical": "tsx examples/query-medical.ts",
    "demo:operation": "tsx examples/operation-guide.ts",
    "test:longyang-core": "tsx scripts/check-longyang-integration.ts",
    "test:operation": "tsx scripts/check-operation-guide.ts",
    "demo:workflow": "tsx scripts/workflow.ts",
    "eval:retrieval": "tsx scripts/workflow.ts --queries-only",
    "eval:boundaries": "node scripts/eval-boundaries.mjs",
    "data:demo": "tsx examples/prepare-demo.ts",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "examples": "tsx examples/member2.ts",
    "eval": "tsx src/evaluate.ts"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "mysql2": "^3.14.0",
    "pdfjs-dist": "6.5.438",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
