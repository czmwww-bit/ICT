# 复制为 backend/.env；所有连接值均需自行替换。也可以由运行环境注入。
DB_HOST=<local-host-or-rds-private-host>
DB_PORT=<mysql-port>
DB_NAME=<database-name>
DB_USER=<application-or-maintenance-user>
DB_PASSWORD=<secret>
DB_TLS=<true-or-false>
DB_SSL_CA=<absolute-path-to-rds-ca-pem-if-tls>
# 仅 test:db 使用；必须是名称以 _test 结尾的独立空测试库
DB_TEST_NAME=<isolated-database_test>
# 以下可选变量默认不启用；需要时取消注释并替换占位值。
# PORT=<http-port-default-3000>
# EVAL_URL=<full-business-guide-http-url>
# EVAL_TIMEOUT_MS=<positive-integer-milliseconds-default-10000>
# SOURCE_CHECK_DIR=<persistent-local-or-ecs-source-check-directory>
# SOURCE_TIMEOUT_MS=<positive-milliseconds-up-to-120000-default-15000>
# ADMIN_STATUS_TOKEN=<random-private-token-at-least-24-characters>
# DB_RESTORE_TEST_NAME=<separate-empty-database_restore_test>
# MYSQL_BIN=<optional-absolute-path-to-mysql-client>
# MYSQLDUMP_BIN=<optional-absolute-path-to-mysqldump>
# MYSQLD_BIN=<optional-absolute-path-to-local-mysqld-for-isolated-drill>
