# 复制到 ECS /opt/silver/secrets/production.env，chmod 600；不要提交真实值
DB_HOST=<rds-private-host>
DB_PORT=<rds-port>
DB_NAME=<official-db-name>
DB_USER=<runtime-read-only-user>
DB_PASSWORD=<runtime-secret>
DB_TLS=<true-or-false>
DB_SSL_CA=/run/certs/rds-ca.pem
PORT=<backend-container-port-3000>
# 后端只读挂载检查记录；手动维护容器用同一卷的读写挂载。
SOURCE_CHECK_DIR=/var/lib/silver-source-check
# 可选；未设置时内部状态接口不注册。不要开放到公网。
# ADMIN_STATUS_TOKEN=<random-private-token-at-least-24-characters>
# SOURCE_TIMEOUT_MS=<positive-milliseconds-default-15000>
